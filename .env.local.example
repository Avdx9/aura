# ============================================
# AURA LONGEVITY — Environment Variables
# Copy to .env.local — NEVER commit .env.local
# ============================================

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token_secret

# Pabau Clinic Management (server-side only — never expose to client)
PABAU_API_KEY=your_pabau_api_key
PABAU_API_BASE_URL=https://api.pabau.com/v2

# Site URL
NEXT_PUBLIC_SITE_URL=https://auralongvity.co.uk

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Revalidation secret for webhooks
REVALIDATION_SECRET=your_revalidation_secret_here
